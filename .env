# 复制这个文件为 .env，然后填你自己的 key
# 命令：cp .env.example .env

# ── 方案 A：DeepSeek（推荐，便宜、中文好）──────────────
# 去 https://platform.deepseek.com 注册 → API keys → 创建
# LLM_API_KEY=sk-你的key贴这里
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── 方案 B：阿里百炼 / 通义千问（换这三行，注释掉上面三行）──
# 去 https://bailian.console.aliyun.com 开通 → API-KEY
LLM_API_KEY=sk-ws-H.ELIILRE.PVUU.MEQCIEYXgU2qkLMaeTz-6h8aFNFJ_UFUOBggKmUYgWlWtFGfAiAx4km1XBDEEuYRBbwt_wib7emoVeQ8sjWTaS2j0b-scw
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ── 算钱用（元 / 百万 token），跑完自己去官网核对真实价格 ──
PRICE_IN_PER_M=2.0
PRICE_OUT_PER_M=8.0
